" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-title" value="CI and CD: nothing deploys unless the evals pass on main" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#232F3E;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="p5-push" value="git push or&#xa;pull request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="70" as="geometry"/></mxCell><mxCell id="p5-test" value="CI: test&#xa;ruff, pytest, gitleaks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="220" height="70" as="geometry"/></mxCell><mxCell id="p5-ev" value="CI: evals&#xa;build golden set, run evals&#xa;(100% required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BC1356;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="260" height="90" as="geometry"/></mxCell><mxCell id="p5-plan" value="CI: terraform plan&#xa;(every PR and push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="120" width="240" height="70" as="geometry"/></mxCell><mxCell id="p5-stop" value="Any failure: CD does not start" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BC1356;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="260" height="70" as="geometry"/></mxCell><mxCell id="p5-cd" value="CD: waits for CI success on main&#xa;and approval (production)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="p5-infra" value="CD: deploy-infra&#xa;terraform apply + vector index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D05C17;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="240" width="260" height="80" as="geometry"/></mxCell><mxCell id="p5-data" value="CD: deploy-data&#xa;generate docs, sync S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#277116;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="380" width="260" height="70" as="geometry"/></mxCell><mxCell id="p5-kbs" value="S3 upload starts the ingestion pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D05C17;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="500" width="260" height="70" as="geometry"/></mxCell><mxCell id="p5-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=11;" edge="1" parent="1" source="p5-push" target="p5-test"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e1" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=11;" edge="1" parent="1" source="p5-test" target="p5-ev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e2" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=11;" edge="1" parent="1" source="p5-ev" target="p5-plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e3" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=11;" edge="1" parent="1" source="p5-ev" target="p5-stop"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e4" value="pass on main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontSize=11;" edge="1" parent="1" source="p5-ev" target="p5-cd"><mxGeometry rel